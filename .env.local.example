# Required: primary application database connection.
DATABASE_URL=postgresql://user:password@host:5432/elite_crm

# Required: canonical application URL and auth signing secret for NextAuth.
NEXTAUTH_URL=https://your-app-domain.com
NEXTAUTH_SECRET=replace_with_long_random_secret

# Required: protects internal runner endpoints.
INTERNAL_RUNNER_KEY=replace_with_secure_random_key

# Required: Supabase project URL for object storage.
SUPABASE_URL=https://your-project-ref.supabase.co
# Required: Supabase service role key used by server-side uploads/deletes.
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
# Required: bucket name used for carrier documents.
SUPABASE_STORAGE_BUCKET=carrier-documents

# Required: org id used by scheduler runner requests.
RUNNER_ORGANIZATION_ID=replace_with_org_id
# Required: public app URL used by scripts/run-internal-runners.mjs.
# Usually this should match NEXTAUTH_URL.
APP_BASE_URL=https://your-app-domain.com

# Optional: provider credentials for AI routes (configure the one(s) you use).
OPENAI_API_KEY=sk-proj-example-key
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: enables Linear sync route integration.
LINEAR_API_KEY=

# Optional: scraping provider key for ScrapingBee proxy mode.
SCRAPINGBEE_API_KEY=
# Optional: custom proxy URL template for scraper ({url} placeholder required).
SCRAPER_PROXY_URL_TEMPLATE=
# Optional: Firecrawl scraping API key.
FIRECRAWL_API_KEY=

# Optional: trust proxy headers when not running on Vercel.
TRUST_PROXY=0
# Optional: local/dev fallback org context.
DEV_DEFAULT_ORG_ID=

# ============================================
# STRIPE BILLING (test mode by default — task t_004fc492)
# ============================================
# Set STRIPE_SECRET_KEY to a TEST key (sk_test_...) to exercise checkout with
# Stripe test cards. Test-mode is the DEFAULT — never put a live key here
# without Brady's explicit go.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). Required before webhooks are processed.
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs for each paid plan (price_...). Get them from your Stripe
# dashboard (test mode products/prices).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_ELITE_MONTHLY=
# Live activation guard: live keys are INERT until this is "1" (Brady's
# explicit go). Do not flip without scoped approval.
STRIPE_LIVE_ACTIVATION=

# ============================================
# AI LEARNING SYSTEM - MAXIMUM ELITE
# ============================================

# OpenAI API for embeddings
# NOTE: OPENAI_API_KEY is defined above (line 20)

# Required: Pinecone API key for vector database
PINECONE_API_KEY=example-pinecone-key
# Required: Pinecone index name for storing AI learning event embeddings
PINECONE_INDEX=kingcrm-ai-events-dev
# Required: Pinecone environment/region (e.g., us-east-1-aws)
PINECONE_ENVIRONMENT=us-east-1-aws

# Required: Cron job authentication secret (min 32 chars, generate: openssl rand -base64 32)
CRON_SECRET=example-secret-change-in-production

# Optional: OpenAI embedding model to use for vector embeddings
EMBEDDING_MODEL=text-embedding-3-small
# Optional: Enable in-memory caching of embeddings to reduce API calls
EMBEDDING_CACHE_ENABLED=true
# Optional: Enable fallback to cached values if embedding generation fails
EMBEDDING_FALLBACK_ENABLED=true

# Optional: Number of records to batch per Pinecone upsert operation
PINECONE_BATCH_SIZE=100
# Optional: Enable Pinecone vector database for RAG-based AI generation
USE_PINECONE_FOR_RAG=true
# Optional: Enable asynchronous background sync to Pinecone (queue-based)
ASYNC_PINECONE_SYNC=true

kingcrmhub.net {
    # HSTS lives on the apex host that actually serves browsers (the static
    # /books block runs entirely in Caddy before Next middleware emits its
    # own HSTS) — the www host only 301-redirects away, so binding the header
    # there protected nothing (cubic P2).
    header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    redir /books /books/ permanent
    # Prefix matcher: /books/* matches /books/ and its subtree only. The bare
    # /books* wildcard also swallowed unrelated paths like /booksfoo (cubic P3).
    handle_path /books/* {
        root * /data/sites/bradys-books
        file_server
    }
    handle {
        reverse_proxy kingcrmhub:3003
    }
}

viralengineviews.com {
    reverse_proxy viral-engine:3001
}

trading.clawhaven.cloud {
    reverse_proxy trading-dashboard:3004
}

claw.clawhaven.cloud {
    reverse_proxy openclaw:18789
}

www.kingcrmhub.net {
    redir https://kingcrmhub.net{uri} permanent
}
